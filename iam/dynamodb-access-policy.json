{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteValidRecordsToDynamoDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:REPLACE_WITH_AWS_REGION:REPLACE_WITH_AWS_ACCOUNT_ID:table/REPLACE_WITH_VALID_RECORDS_TABLE"
    }
  ]
}
