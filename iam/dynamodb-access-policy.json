{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteValidRecordsToDynamoDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:123456789012:table/csv-valid-records"
    }
  ]
}
