{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowExecutionLogging",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogDelivery",
        "logs:GetLogDelivery",
        "logs:UpdateLogDelivery",
        "logs:DeleteLogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutRetentionPolicy",
        "logs:PutLogEvents",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InvokeCsvCleanerLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:REPLACE_WITH_AWS_REGION:REPLACE_WITH_AWS_ACCOUNT_ID:function:REPLACE_WITH_CSV_CLEANER_FUNCTION"
    },
    {
      "Sid": "InvokeInvalidRowsLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": "arn:aws:lambda:REPLACE_WITH_AWS_REGION:REPLACE_WITH_AWS_ACCOUNT_ID:function:REPLACE_WITH_INVALID_ROWS_FUNCTION"
    }
  ]
}
