{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSourceCsvFiles",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::csv-input-bucket",
        "arn:aws:s3:::csv-input-bucket/*"
      ]
    },
    {
      "Sid": "WriteRejectedCsvFiles",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::csv-invalid-bucket/*"
    }
  ]
}
