{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSourceCsvFiles",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_CSV_INPUT_BUCKET",
        "arn:aws:s3:::REPLACE_WITH_CSV_INPUT_BUCKET/*"
      ]
    },
    {
      "Sid": "WriteRejectedCsvFiles",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_INVALID_CSV_BUCKET/*"
    }
  ]
}
